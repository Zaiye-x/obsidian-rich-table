{
  "name": "obsidian-rich-table",
  "version": "0.1.2",
  "private": true,
  "description": "Local visual tables for Obsidian notes",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "dev": "node esbuild.mjs --watch",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "@types/jsdom": "^21.1.7",
    "obsidian": "^1.8.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
